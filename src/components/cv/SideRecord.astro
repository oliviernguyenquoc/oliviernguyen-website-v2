---
interface Props {
  logo?: string;
  emoji?: string;
  alt?: string;
  title: string;
}
const { logo, emoji, alt = "", title } = Astro.props;
---

<article class="cv-side-record">
  <div class="cv-side-logo">
    {
      emoji ? (
        <span class="cv-record-emoji" aria-hidden="true">
          {emoji}
        </span>
      ) : logo ? (
        <img src={`/assets/${logo}`} alt={alt} loading="lazy" />
      ) : (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          aria-hidden="true"
        >
          <path d="M12 5v15M12 6C8 3 4 4 2 5v14c3-1 6-1 10 1 4-2 7-2 10-1V5c-2-1-6-2-10 1Z" />
        </svg>
      )
    }
  </div>
  <div class="min-w-0"><h3>{title}</h3><slot /></div>
</article>
