---
import Header from "@/components/shared/Header.astro";
import Footer from "@/components/shared/Footer.astro";
import { url, words } from "@/lib/pages.js";
import "@/styles/global.css";
interface Props {
  lang: "fr" | "en";
  page: string;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const fullTitle = `${title} — Olivier Nguyen Quoc`;
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#254b3d" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(url("fr", page), origin)} />
    <link rel="alternate" hreflang="en" href={new URL(url("en", page), origin)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/assets/olivier.jpg", origin)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/Aspekta-500.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class={`page-${page}`}>
    <a class="skip" href="#main">{words[lang].skip}</a>
    <Header lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script>
      import "../scripts/interactions";
    </script>
  </body>
</html>
